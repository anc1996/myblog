# myblog 原生生产环境配置模板（请复制为受控 .env.production 并 chmod 600，严禁提交真实凭据）

# 1. Django 生产核心安全参数（必填）
# 生成方式示例：python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-random-secret-key-at-least-50-characters-long
ALLOWED_HOSTS=blog.example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://blog.example.com,https://www.example.com
WAGTAILADMIN_BASE_URL=https://blog.example.com

# 2. HTTPS / 反向代理安全开关（Nginx 终结 TLS 并转发到 127.0.0.1:8000）
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_BEHIND_TLS_PROXY=1
DJANGO_USE_X_FORWARDED_HOST=0
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1

# 3. 静态与媒体目录 / Nginx X-Accel-Redirect 内部代理
# DJANGO_STATIC_ROOT=/path/to/myblog/staticfiles
# DJANGO_MEDIA_ROOT=/path/to/myblog/media
# 仅在完成 Nginx 内部 S3 SigV4 签名代理配置并实测（第 5 步）后改为 1
USE_X_ACCEL_REDIRECT=0
DJANGO_LOG_LEVEL=INFO

# 4. PostgreSQL 18 主库
POSTGRES_DB=myblog_prod
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_CONN_MAX_AGE=60

# 5. MongoDB 9 正文外置存储
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=replace-with-mongo-password
MONGO_AUTH_SOURCE=admin
MONGO_NAME=myblog_prod

# 6. Redis 8 缓存与验证码
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_DB=1
REDIS_KEY_PREFIX=myblog_prod

# 7. RustFS / S3 私有对象存储
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_BUCKET=myblog-prod
S3_REGION=us-east-1
